[Interface]
Address = {{ local_ip }}
PrivateKey = {{ private_key }}
ListenPort = {{ local_port }}
{% for peer in peers %}

[Peer]
PublicKey = {{ peer.public_key }}
    {% if peer.network %}
AllowedIPs = {{ peer.network }}
    {% endif %}
    {% if peer.endpoint %}
Endpoint = {{ peer.endpoint }}
    {% endif %}
{% endfor %}
